# Copy to infra/.env and adapt. No secret here: secrets live in infra/secrets/ (see
# scripts/init-secrets.sh).

# Public host name of LifeOS (Traefik routing, WebAuthn relying party).
LIFEOS_DOMAIN=lifeos.example.lan
LIFEOS_PUBLIC_ORIGIN=https://lifeos.example.lan
LIFEOS_WEBAUTHN_RP_ID=lifeos.example.lan

# Compose overlays, kept here so that every `docker compose` command uses them (install.sh
# sets this line): compose.gpu.yaml (transcription on the GPU), compose.proxy.yaml (behind an
# existing reverse proxy such as Nginx Proxy Manager, which then owns ports 80/443 and TLS).
#COMPOSE_FILE=compose.yaml:compose.proxy.yaml
# Docker network shared with that reverse proxy (compose.proxy.yaml).
#LIFEOS_PROXY_NETWORK=lifeos-proxy

LIFEOS_ENVIRONMENT=production
LIFEOS_LOG_LEVEL=INFO
LIFEOS_EXPOSE_OPENAPI=false
LIFEOS_TIMEZONE=Europe/Paris

# LLM: disabled | fake | gemini (ADR 0003, ADR 0007). Gemini Developer API with an AI Studio
# key from a Google Cloud project WITHOUT a billing account: Google cannot charge anything,
# requests beyond the free quota are refused (HTTP 429). Check your project's real limits
# in AI Studio and keep the daily caps below them.
LIFEOS_LLM_PROVIDER=disabled
LIFEOS_GEMINI_BACKEND=developer
# "fast" tier: chat, extraction, consolidation. "deep" tier: reviews (bilans).
LIFEOS_GEMINI_MODEL=gemini-3.5-flash-lite
LIFEOS_GEMINI_MODEL_DEEP=gemini-3.8-flash
LIFEOS_GEMINI_THINKING_FAST=minimal
LIFEOS_GEMINI_THINKING_DEEP=low
# free: daily request caps per tier (reset at midnight Pacific time, like Google's quotas).
# paid: cost budgets in USD (only if you deliberately link a billing account).
LIFEOS_LLM_BILLING=free
LIFEOS_LLM_DAILY_REQUESTS_FAST=400
LIFEOS_LLM_DAILY_REQUESTS_DEEP=15
# Requests kept below each daily cap (ADR 0010): LifeOS stops at 398 / 13 with the values
# above. Paid billing keeps LIFEOS_LLM_BUDGET_MARGIN_RATIO (0.05) of the USD budgets aside.
LIFEOS_LLM_QUOTA_MARGIN_REQUESTS=2
# Vertex AI only (EU data residency): project and region, plus service account credentials.
LIFEOS_GEMINI_VERTEX_PROJECT=
LIFEOS_GEMINI_VERTEX_LOCATION=europe-west1

# Local embeddings (ADR 0006): semantic search and memory quality, computed on the VM.
# remote = the internal `ml` service. Download the model once:
#   docker compose --profile setup run --rm ml-download
LIFEOS_EMBEDDINGS_PROVIDER=remote
LIFEOS_EMBEDDINGS_MODEL=google/embeddinggemma-300m
# ONNX Runtime threads of the ml service (physical cores; the i7-6700 has 4).
LIFEOS_EMBEDDINGS_THREADS=4

# Documents (F10, ADR 0008): text extraction of PDFs and pictures (OCR) on the VM.
# remote = the internal `ml` service (Tesseract, French); disabled = plain text files only.
LIFEOS_EXTRACTION_PROVIDER=remote
# Memory of one extraction in the ml service (MiB): a hostile file fails instead of
# exhausting the service.
LIFEOS_EXTRACTION_MEMORY_MB=1280
# Upload limit (bytes, 20 MiB), pages per PDF, and how long encrypted originals are kept
# (days). The ml service reads the same limits.
LIFEOS_DOCUMENTS_MAX_BYTES=20971520
LIFEOS_DOCUMENTS_MAX_PAGES=30
LIFEOS_DOCUMENTS_ORIGINAL_RETENTION_DAYS=90

# Voice dictation (UC01, ADR 0009): transcribed on the VM, the recording deleted afterwards.
# remote = the internal `stt` service; disabled = no dictation. Download the model once:
#   docker compose --profile setup run --rm stt-download
LIFEOS_STT_PROVIDER=remote
LIFEOS_STT_MODEL=large-v3-turbo
# auto = the GPU when one is visible (compose.gpu.yaml), else the CPU.
LIFEOS_STT_DEVICE=auto
LIFEOS_STT_THREADS=4
# Longest dictation (seconds); the model is unloaded after this long without one.
LIFEOS_VOICE_MAX_SECONDS=900
LIFEOS_STT_IDLE_UNLOAD_S=600
