# LifeOS backups: /etc/lifeos/backup.env (root, mode 0600), created from this file by
# infra/scripts/install-backups.sh. Read by the systemd units (EnvironmentFile) and by the
# backup scripts run by hand. One KEY=value per line; a value with spaces or special
# characters goes between single quotes.
# It holds credentials: never commit it; its content is part of the recovery sheet
# (infra/scripts/export-keys.sh) kept in your password manager.

# Main restic repository (restic >= 0.17). Any restic backend, for example:
#   /srv/backups/lifeos                          another disk of this server (add a copy below)
#   sftp:backup@nas.example.lan:/srv/restic/lifeos     NAS over SSH (key in /root/.ssh)
#   rest:https://user:password@backup.example.org:8000/lifeos   restic rest-server
#   b2:bucket-name:lifeos                        Backblaze B2 (B2_ACCOUNT_ID, B2_ACCOUNT_KEY)
#   s3:s3.eu-west-3.amazonaws.com/bucket/lifeos  S3 or compatible (AWS_ACCESS_KEY_ID...)
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/lifeos/restic-password

# Off-site copy, recommended when the main repository is on this site: the same snapshots,
# the same retention (14 daily + 4 weekly: erased data leaves it as fast), checked after each
# copy and restored monthly as a test. Leave empty if the main repository is already off-site.
RESTIC_COPY_REPOSITORY=
RESTIC_COPY_PASSWORD_FILE=/etc/lifeos/restic-copy-password

# Credentials of the repositories (only those your backends need; both repositories of the
# same backend type share them).
#B2_ACCOUNT_ID=
#B2_ACCOUNT_KEY=
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_DEFAULT_REGION=

# Is the main repository off this machine? auto: a local path is not, anything else
# (sftp:, rest:, b2:, s3:...) is. Drives lifeos_backup_offsite_last_success_timestamp_seconds.
LIFEOS_BACKUP_PRIMARY_OFFSITE=auto

# Alert when a backup, a restore test or a data check fails (systemd OnFailure): an ntfy topic
# URL (https://ntfy.sh/<long random topic>, or your own ntfy server), or any webhook taking a
# plain-text POST. Only the unit, the host and the time are sent.
LIFEOS_ALERT_URL=
# ntfy access token, if the topic is protected (sent as "Authorization: Bearer").
LIFEOS_ALERT_TOKEN=

# Dead man's switch on ANOTHER machine (healthchecks.io or self-hosted): pinged at start, on
# success (base URL) and on failure (/fail); it alerts when no backup reports, even when this
# server is down. Optional, recommended.
LIFEOS_HEALTHCHECK_URL=
LIFEOS_RESTORE_CHECK_HEALTHCHECK_URL=
# Another check (period 5 minutes), pinged by the monitoring while it works
# (infra/scripts/install-monitoring.sh, which also reads LIFEOS_ALERT_URL and _TOKEN above).
LIFEOS_MONITORING_HEALTHCHECK_URL=

# Prometheus textfile metrics (node exporter textfile collector): lifeos_backup.prom,
# lifeos_restore_check.prom.
LIFEOS_METRICS_DIR=/var/lib/lifeos/metrics
