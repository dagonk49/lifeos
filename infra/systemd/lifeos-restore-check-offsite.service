# Monthly restore test from the off-site copy (infra/scripts/restore-check.sh --offsite): proves
# that the copy outside this machine restores. A failure sends an alert.
[Unit]
Description=LifeOS restore test (latest backup, off-site copy)
Documentation=file:///opt/lifeos/docs/restauration.md
Wants=network-online.target
After=network-online.target docker.service
OnFailure=lifeos-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/lifeos/backup.env
WorkingDirectory=/opt/lifeos/infra
ExecStart=/opt/lifeos/infra/scripts/restore-check.sh --offsite
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=6h
